---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "left" } = Astro.props;
---

<div class={`section-heading section-heading--${align}`}>
  <span class="section-heading__eyebrow">{eyebrow}</span>
  <h2>{title}</h2>
  <p>{description}</p>
</div>

