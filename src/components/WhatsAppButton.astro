---
import { buildWhatsAppUrl } from "../lib/whatsapp";
import { siteConfig } from "../config/site";

interface Props {
  label: string;
  source: string;
  className?: string;
  messageTemplate?: string;
}

const {
  label,
  source,
  className = "",
  messageTemplate = siteConfig.whatsapp.defaultMessage
} = Astro.props;
const href = buildWhatsAppUrl(messageTemplate, source);
---

<a
  class={`cta-button ${className}`.trim()}
  href={href}
  target="_blank"
  rel="noopener noreferrer nofollow"
  data-cta-source={source}
>
  <svg aria-hidden="true" viewBox="0 0 24 24">
    <path
      d="M19.05 4.94A9.88 9.88 0 0 0 12.02 2C6.57 2 2.13 6.38 2.13 11.82c0 1.74.46 3.43 1.33 4.92L2 22l5.43-1.42a9.87 9.87 0 0 0 4.59 1.16h.01c5.45 0 9.89-4.38 9.89-9.82 0-2.63-1.03-5.11-2.87-6.98Zm-7.03 15.1h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.22.84.86-3.12-.2-.32a8.07 8.07 0 0 1-1.25-4.3c0-4.47 3.65-8.11 8.15-8.11a8.1 8.1 0 0 1 5.77 2.39 8.01 8.01 0 0 1 2.36 5.72c0 4.48-3.66 8.12-8.14 8.12Zm4.45-6.08c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.23-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1-.36-1.91-1.15-.71-.61-1.19-1.37-1.33-1.6-.14-.23-.01-.35.11-.47.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.29-.02-.41-.06-.12-.54-1.28-.74-1.75-.2-.48-.4-.41-.54-.42-.14 0-.3-.01-.46-.01-.16 0-.42.06-.64.29-.22.23-.84.82-.84 2 0 1.17.87 2.31.99 2.47.12.16 1.69 2.68 4.17 3.65 2.48.98 2.48.65 2.93.61.45-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.29Z"
      fill="currentColor"
    />
  </svg>
  <span>{label}</span>
</a>
